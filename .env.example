BOT_TOKEN=
BOT_USERNAME=
WEBHOOK_SECRET=
DATABASE_URL=postgresql+asyncpg://office_party:office_party@postgres:5432/office_party
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Asia/Almaty

SMOKE_EVENT_TTL_MINUTES=15
COFFEE_EVENT_TTL_MINUTES=20
LUNCH_EVENT_TTL_MINUTES=30
AFTER_WORK_EVENT_TTL_MINUTES=180
CUSTOM_EVENT_TTL_MINUTES=30

SMOKE_COOLDOWN_MINUTES=0
COFFEE_COOLDOWN_MINUTES=0
LUNCH_COOLDOWN_MINUTES=0
AFTER_WORK_COOLDOWN_MINUTES=0
CUSTOM_COOLDOWN_MINUTES=0

NOTIFICATION_CONCURRENCY=10
NOTIFICATION_RATE_PER_SECOND=25
NOTIFY_ON_EVENT_STARTED=true
NOTIFY_ON_EVENT_CANCELLED=true
EVENT_EXPIRATION_INTERVAL_SECONDS=30
